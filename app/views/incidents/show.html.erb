<%= govuk_breadcrumbs(breadcrumbs: { "Home" => root_path, @incident.title => nil }) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <% if notice.present? %>
      <%= govuk_notification_banner(title_text: "Success", success: true) do |banner|
            banner.with_heading(text: notice)
          end %>
    <% end %>
    <% if alert.present? %>
      <%= govuk_notification_banner(title_text: "There is a problem") do |banner|
            banner.with_heading(text: alert)
          end %>
    <% end %>

    <span class="govuk-caption-l">Incident #<%= @incident.id %></span>
    <h1 class="govuk-heading-l"><%= @incident.title %></h1>

    <%= govuk_tag(text: @incident.status.capitalize, colour: @incident.status == "open" ? "red" : "green") %>

    <dl class="govuk-summary-list govuk-!-margin-top-4">
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Service</dt>
        <dd class="govuk-summary-list__value"><%= @incident.service %></dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Status</dt>
        <dd class="govuk-summary-list__value"><%= @incident.status.capitalize %></dd>
      </div>
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">Reported</dt>
        <dd class="govuk-summary-list__value"><%= @incident.created_at.strftime("%-d %B %Y at %H:%M") %></dd>
      </div>
    </dl>

    <h2 class="govuk-heading-m">What happened</h2>
    <%= simple_format(@incident.description, class: "govuk-body") %>

    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

    <h2 class="govuk-heading-l">Artefacts</h2>

    <%# ============================================================ %>
    <%# Category: Incident response process                          %>
    <%# ============================================================ %>
    <section class="govuk-!-margin-bottom-8">
      <h3 class="govuk-heading-m">Incident response process</h3>

      <% process_artefact = @incident.process_artefact %>
      <% if process_artefact.nil? %>
        <p class="govuk-body govuk-hint">Not generated yet.</p>

        <%= form_with url: incident_process_artefact_path(@incident), method: :post, local: true do %>
          <%= submit_tag "Generate process", class: "govuk-button" %>
        <% end %>

      <% else %>
        <p class="govuk-body">
          <strong>Severity:</strong>
          <%= govuk_tag(text: process_artefact.severity_guess,
                        colour: { "P1" => "red", "P2" => "orange", "P3" => "yellow", "P4" => "blue" }.fetch(process_artefact.severity_guess, "grey")) %>
          &nbsp;<span class="govuk-body-s govuk-!-colour-secondary"><%= process_artefact.severity_reasoning %></span>
        </p>

        <h4 class="govuk-heading-s">Immediate actions</h4>
        <ul class="govuk-list govuk-list--bullet">
          <% process_artefact.immediate_actions.each do |action| %>
            <li><%= action %></li>
          <% end %>
        </ul>

        <h4 class="govuk-heading-s">Communication actions</h4>
        <ul class="govuk-list govuk-list--bullet">
          <% process_artefact.communication_actions.each do |action| %>
            <li><%= action %></li>
          <% end %>
        </ul>

        <h4 class="govuk-heading-s">Escalation path</h4>
        <ol class="govuk-list govuk-list--number">
          <% process_artefact.escalation_path.each do |role| %>
            <li><%= role %></li>
          <% end %>
        </ol>

        <p class="govuk-body govuk-!-margin-top-6">
          <%= link_to "Download as Word document",
                      download_incident_process_artefact_path(@incident),
                      class: "govuk-button govuk-button--secondary",
                      data: { module: "govuk-button" } %>
        </p>
      <% end %>
    </section>

    <%# ============================================================ %>
    <%# Category: Runbook                                            %>
    <%# ============================================================ %>
    <section class="govuk-!-margin-bottom-8">
      <h3 class="govuk-heading-m">
        Runbook
        <% if @incident.runbook_artefact.present? %>
          <%= govuk_tag(text: @incident.runbook_artefact.match_type.capitalize,
                        colour: case @incident.runbook_artefact.match_type
                                when "retrieved" then "green"
                                when "drafted"   then "yellow"
                                else "red"
                                end) %>
        <% end %>
      </h3>

      <% runbook = @incident.runbook_artefact %>
      <% if runbook.nil? %>
        <p class="govuk-body govuk-hint">Not looked up yet.</p>

        <%= form_with url: incident_runbook_artefact_path(@incident), method: :post, local: true do %>
          <%= submit_tag "Find runbook", class: "govuk-button" %>
        <% end %>

      <% elsif runbook.refused? %>
        <p class="govuk-body">
          <strong>No runbook covers this incident.</strong>
        </p>
        <p class="govuk-body"><%= runbook.refusal_reason %></p>
        <p class="govuk-body">
          <strong>Escalate to:</strong> <code><%= runbook.owner_to_escalate_to %></code>
        </p>

        <p class="govuk-body govuk-!-margin-top-6">
          <%= link_to "Download as Word document",
                      download_incident_runbook_artefact_path(@incident),
                      class: "govuk-button govuk-button--secondary",
                      data: { module: "govuk-button" } %>
        </p>

      <% else %>
        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Source</dt>
            <dd class="govuk-summary-list__value">
              <% if runbook.runbook_id.present? %>
                <code><%= runbook.runbook_id %></code>
                <% if runbook.cited_section.present? %>
                  &mdash; <%= runbook.cited_section %>
                <% end %>
                <% if runbook.drafted? %>
                  <span class="govuk-hint govuk-!-margin-0"><em>(drafted from this close match)</em></span>
                <% end %>
              <% else %>
                <span class="govuk-hint">Drafted from scratch &mdash; no similar runbook in the corpus</span>
              <% end %>
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Escalate to</dt>
            <dd class="govuk-summary-list__value"><code><%= runbook.owner_to_escalate_to %></code></dd>
          </div>
        </dl>

        <% if runbook.drafted? && runbook.general_guidance.present? %>
          <div class="govuk-inset-text">
            <%= runbook.general_guidance %>
          </div>
        <% end %>

        <h4 class="govuk-heading-s">Steps</h4>
        <ol class="govuk-list govuk-list--number">
          <% runbook.steps.each do |step| %>
            <li>
              <strong><%= step["action"] %></strong>
              <% if step["commands"].present? %>
                <% Array(step["commands"]).each do |cmd| %>
                  <pre class="govuk-!-margin-top-2 govuk-!-margin-bottom-2" style="background:#f3f2f1; padding:0.5rem; overflow-x:auto;"><code><%= cmd %></code></pre>
                <% end %>
              <% end %>
              <% if step["verification"].present? %>
                <p class="govuk-body-s govuk-hint govuk-!-margin-bottom-4"><em>Verify:</em> <%= step["verification"] %></p>
              <% end %>
            </li>
          <% end %>
        </ol>

        <p class="govuk-body govuk-!-margin-top-6">
          <%= link_to "Download as Word document",
                      download_incident_runbook_artefact_path(@incident),
                      class: "govuk-button govuk-button--secondary",
                      data: { module: "govuk-button" } %>
        </p>
      <% end %>
    </section>

    <%# ============================================================ %>
    <%# Category: Post-incident review                               %>
    <%# ============================================================ %>
    <section class="govuk-!-margin-bottom-8">
      <h3 class="govuk-heading-m">Post-incident review</h3>

      <% review = @incident.review_artefact %>
      <% if review.nil? && @incident.status == "open" %>
        <p class="govuk-body govuk-hint">
          Available once the incident is resolved. Marking it resolved
          will open a short form and draft the review.
        </p>
        <%= link_to "Mark resolved",
                    new_incident_review_artefact_path(@incident),
                    class: "govuk-button" %>

      <% elsif review.nil? %>
        <p class="govuk-body govuk-hint">Not drafted yet.</p>
        <%= link_to "Draft review",
                    new_incident_review_artefact_path(@incident),
                    class: "govuk-button" %>

      <% else %>
        <details class="govuk-details" data-module="govuk-details">
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">Show review</span>
          </summary>
          <div class="govuk-details__text">

        <blockquote class="govuk-inset-text">
          <em>Regardless of what we discover, we understand and truly
          believe that everyone did the best job they could, given what
          they knew at the time, their skills and abilities, the
          resources available, and the situation at hand.</em>
        </blockquote>

        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">User impact</dt>
            <dd class="govuk-summary-list__value"><%= review.user_impact %></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Root cause</dt>
            <dd class="govuk-summary-list__value"><%= review.root_cause %></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">End date &amp; time</dt>
            <dd class="govuk-summary-list__value"><%= review.end_datetime.strftime("%-d %B %Y at %H:%M") %></dd>
          </div>
          <% [["Technical lead", review.technical_lead],
              ["Comms lead",     review.comms_lead],
              ["Support lead",   review.support_lead]].each do |label, value| %>
            <% if value.present? %>
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key"><%= label %></dt>
                <dd class="govuk-summary-list__value"><%= value %></dd>
              </div>
            <% end %>
          <% end %>
        </dl>

        <h4 class="govuk-heading-s">Timeline</h4>
        <% if review.timeline.any? %>
          <table class="govuk-table">
            <thead class="govuk-table__head">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Time</th>
                <th scope="col" class="govuk-table__header">Event</th>
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              <% review.timeline.each do |row| %>
                <tr class="govuk-table__row">
                  <td class="govuk-table__cell"><%= row["time"] %></td>
                  <td class="govuk-table__cell"><%= row["event"] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="govuk-body govuk-hint">No timeline recorded.</p>
        <% end %>

        <h4 class="govuk-heading-s">Were we alerted quickly?</h4>
        <p class="govuk-body"><%= review.alerted_quickly %></p>

        <h4 class="govuk-heading-s">Were we able to diagnose and fix the immediate issue quickly?</h4>
        <p class="govuk-body"><%= review.diagnosed_and_fixed_quickly %></p>

        <h4 class="govuk-heading-s">How did we solve the problem?</h4>
        <p class="govuk-body"><%= review.how_we_solved_it %></p>

        <h4 class="govuk-heading-s">Was the process followed well, were comms effective?</h4>
        <p class="govuk-body"><%= review.process_and_comms %></p>

        <h4 class="govuk-heading-s">What could we do to prevent this from happening again?</h4>
        <ul class="govuk-list govuk-list--bullet">
          <% review.prevent_recurrence.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>

        <h4 class="govuk-heading-s">What could we do to improve our response?</h4>
        <ul class="govuk-list govuk-list--bullet">
          <% review.improve_response.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>

        <h4 class="govuk-heading-s">What could we do to improve comms/process?</h4>
        <ul class="govuk-list govuk-list--bullet">
          <% review.improve_process_comms.each do |item| %>
            <li><%= item %></li>
          <% end %>
        </ul>

        <% if review.runbook_diff.present? %>
          <h4 class="govuk-heading-s">Runbook changes</h4>
          <pre class="govuk-!-margin-bottom-4" style="background:#f3f2f1; padding:0.75rem; overflow-x:auto; white-space:pre-wrap;"><code><%= review.runbook_diff %></code></pre>
        <% end %>

        <p class="govuk-body govuk-!-margin-top-6">
          <%= link_to "Download as Word document",
                      download_incident_review_artefact_path(@incident),
                      class: "govuk-button govuk-button--secondary",
                      data: { module: "govuk-button" } %>
        </p>

          </div>
        </details>
      <% end %>
    </section>

  </div>
</div>
