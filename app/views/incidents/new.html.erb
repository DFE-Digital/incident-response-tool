<%= govuk_breadcrumbs(breadcrumbs: { "Home" => root_path, "Report an incident" => nil }) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Report an incident</h1>

    <p class="govuk-body-s govuk-hint">
      API keys and email addresses are automatically redacted from the
      description before it reaches Claude. Descriptions are limited to
      10,000 characters.
    </p>

    <%= form_with model: @incident, local: true, builder: GOVUKDesignSystemFormBuilder::FormBuilder do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_text_field :title,
            label: { text: "Incident title", size: "m" },
            hint: { text: "A short summary, e.g. 'DPS status API timing out'" } %>

      <%= f.govuk_select :service,
            Incident::SERVICES.map { |s| [s, s] },
            options: { include_blank: "Select a service" },
            label: { text: "Affected service", size: "m" } %>

      <%= f.govuk_text_area :description,
            label: { text: "What is happening?", size: "m" },
            hint: { text: "Describe the symptoms, when it started, and who is affected. Paste log output, error messages or alert text." },
            rows: 8 %>

      <%= f.govuk_submit "Submit incident", data: { disable_with: "Submitting…" } %>
    <% end %>

    <script>
      // Prevent double-submit: as soon as the form starts submitting, disable
      // the submit button and swap its label to the data-disable-with text.
      // Uses setTimeout(0) so the button disables *after* the browser has
      // already accepted the submission (a synchronously-disabled button
      // aborts the submit in some browsers).
      (function () {
        var form = document.querySelector("form");
        if (!form) return;
        form.addEventListener("submit", function () {
          setTimeout(function () {
            var btn = form.querySelector('[type="submit"]');
            if (!btn || btn.disabled) return;
            btn.disabled = true;
            var label = btn.getAttribute("data-disable-with");
            if (label) {
              if (btn.tagName === "BUTTON") { btn.textContent = label; }
              else { btn.value = label; }
            }
          }, 0);
        });
      })();
    </script>
  </div>
</div>
